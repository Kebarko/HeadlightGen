<Window x:Class="KE.MSTS.HeadlightGen.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KE.MSTS.HeadlightGen.ViewModels"
        Title="HeadlightGen" MinWidth="800" MinHeight="600" Width="800" Height="600"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="100px" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.Resources>
                <Style TargetType="Grid">
                    <Setter Property="Background" Value="#F5F5F5" />
                </Style>
                <Style TargetType="Label">
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="10,3,6,3" />
                    <Setter Property="Foreground" Value="#1F1F1F" />
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Margin" Value="10,3,1,3" />
                    <Setter Property="FontFamily" Value="Consolas" />
                    <Setter Property="HorizontalContentAlignment" Value="Right" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="6,3" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="BorderBrush" Value="#C8C8C8" />
                    <Setter Property="Background" Value="White" />
                    <Setter Property="SnapsToDevicePixels" Value="True" />
                    <Style.Triggers>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter Property="Background" Value="#E8E8E8" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="Button">
                    <Setter Property="Margin" Value="10,6,1,6" />
                    <Setter Property="Padding" Value="10,5" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Background" Value="#6BBDF3" />
                    <Setter Property="Foreground" Value="#1F1F1F" />
                    <Setter Property="BorderBrush" Value="#C8C8C8" />
                    <Setter Property="BorderThickness" Value="1" />
                </Style>
            </Grid.Resources>

            <Label Grid.Row="0" Grid.Column="0" Content="Title" />
            <TextBox Grid.Row="0" Grid.Column="1" ToolTip="The title to add to the output"
                     Text="{Binding Path=Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="1" Grid.Column="0" Content="Center X" />
            <TextBox Grid.Row="1" Grid.Column="1" ToolTip="The X coordinate of the light center point."
                     Text="{Binding Path=CenterX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Label Grid.Row="1" Grid.Column="2" Content="m" />

            <Label Grid.Row="2" Grid.Column="0" Content="Center Y" />
            <TextBox Grid.Row="2" Grid.Column="1" ToolTip="The Y coordinate of the light center point."
                     Text="{Binding Path=CenterY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Label Grid.Row="2" Grid.Column="2" Content="m" />

            <Label Grid.Row="3" Grid.Column="0" Content="Center Z" />
            <TextBox Grid.Row="3" Grid.Column="1" ToolTip="The Z coordinate of the light center point."
                Text="{Binding Path=CenterZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Label Grid.Row="3" Grid.Column="2" Content="m" />

            <Label Grid.Row="4" Grid.Column="0" Content="Number of circles" />
            <TextBox Grid.Row="4" Grid.Column="1" ToolTip="The number of concentric circles to generate."
                     Text="{Binding Path=Circles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     PreviewKeyDown="TextBox_PreviewKeyDown" />

            <Label Grid.Row="5" Grid.Column="0" Content="Max. radius" />
            <TextBox Grid.Row="5" Grid.Column="1" ToolTip="The maximum radius for the outermost circle."
                     Text="{Binding Path=MaxRadius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Label Grid.Row="5" Grid.Column="2" Content="cm" />

            <Label Grid.Row="6" Grid.Column="0" Content="Increment" />
            <TextBox Grid.Row="6" Grid.Column="1"
                     ToolTip="The increment value determining the number of segments per circle."
                     Text="{Binding Path=Increment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     PreviewKeyDown="TextBox_PreviewKeyDown" />

            <Label Grid.Row="7" Grid.Column="0" Content="Base angle" />
            <TextBox Grid.Row="7" Grid.Column="1"
                     ToolTip="The base angle in degrees for the initial segment orientation."
                     Text="{Binding Path=BaseAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     PreviewKeyDown="TextBox_PreviewKeyDown" />
            <Label Grid.Row="7" Grid.Column="2" Content="°" />

            <Label Grid.Row="8" Grid.Column="0" Content="Total segments" />
            <TextBox Grid.Row="8" Grid.Column="1" IsReadOnly="True" Focusable="False"
                     ToolTip="The total number of segments calculated from the current settings."
                     Text="{Binding Path=TotalSegments, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Row="9" Grid.Column="1" Content="Generate" Command="{Binding GenerateCommand}" />
        </Grid>
        <Canvas x:Name="MainCanvas" Grid.Row="0" Grid.Column="1" Margin="50" Loaded="CanvasLoaded" SizeChanged="CanvasSizeChanged">
            <ItemsControl  ItemsSource="{Binding Shapes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="FrameworkElement">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </Canvas>
    </Grid>
</Window>
