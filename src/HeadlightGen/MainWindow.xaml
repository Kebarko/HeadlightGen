<Window x:Class="KE.MSTS.HeadlightGen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HeadlightGen" Width="800" Height="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="100px" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.Resources>
                <Style TargetType="Grid">
                    <Setter Property="Background" Value="#F5F5F5" />
                </Style>
                <Style TargetType="Label">
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="10,3,6,3" />
                    <Setter Property="Foreground" Value="#1F1F1F" />
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Margin" Value="10,3,1,3" />
                    <Setter Property="FontFamily" Value="Consolas" />
                    <Setter Property="HorizontalContentAlignment" Value="Right" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="6,3" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="BorderBrush" Value="#C8C8C8" />
                    <Setter Property="Background" Value="White" />
                    <Setter Property="SnapsToDevicePixels" Value="True" />
                </Style>
                <Style TargetType="Button">
                    <Setter Property="Margin" Value="10,6,1,6" />
                    <Setter Property="Padding" Value="10,5" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Background" Value="#6BBDF3" />
                    <Setter Property="Foreground" Value="#1F1F1F" />
                    <Setter Property="BorderBrush" Value="#C8C8C8" />
                    <Setter Property="BorderThickness" Value="1" />
                </Style>
            </Grid.Resources>

            <Label Grid.Row="0" Grid.Column="0" Content="Center X" />
            <TextBox Grid.Row="0" Grid.Column="1" Name="InputCenterX" />
            <Label Grid.Row="0" Grid.Column="2" Content="m" />

            <Label Grid.Row="1" Grid.Column="0" Content="Center Y" />
            <TextBox Grid.Row="1" Grid.Column="1" Name="InputCenterY" />
            <Label Grid.Row="1" Grid.Column="2" Content="m" />

            <Label Grid.Row="2" Grid.Column="0" Content="Number of circles" />
            <TextBox Grid.Row="2" Grid.Column="1" Name="InputCircles" />

            <Label Grid.Row="3" Grid.Column="0" Content="Max. radius" />
            <TextBox Grid.Row="3" Grid.Column="1" Name="InputMaxRadius" />
            <Label Grid.Row="3" Grid.Column="2" Content="cm" />

            <Label Grid.Row="4" Grid.Column="0" Content="Increment" />
            <TextBox Grid.Row="4" Grid.Column="1" Name="InputIncrement" />

            <Label Grid.Row="5" Grid.Column="0" Content="Base angle" />
            <TextBox Grid.Row="5" Grid.Column="1" Name="InputBaseAngle" />
            <Label Grid.Row="5" Grid.Column="2" Content="°" />

            <Button Grid.Row="6" Grid.Column="1" Content="Generate" Name="GenerateButton" />
        </Grid>
        <Canvas Grid.Row="0" Grid.Column="1" Name="TbCanvas" Margin="50" />
    </Grid>
</Window>

